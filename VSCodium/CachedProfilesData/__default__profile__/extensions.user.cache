oup":"navigation@1","when":"view == roo-cline.SidebarProvider"},{"command":"roo-cline.settingsButtonClicked","group":"navigation@2","when":"view == roo-cline.SidebarProvider"},{"command":"roo-cline.historyButtonClicked","group":"overflow@1","when":"view == roo-cline.SidebarProvider"},{"command":"roo-cline.popoutButtonClicked","group":"overflow@2","when":"view == roo-cline.SidebarProvider"}],"editor/title":[{"command":"roo-cline.plusButtonClicked","group":"navigation@1","when":"activeWebviewPanelId == roo-cline.TabPanelProvider"},{"command":"roo-cline.settingsButtonClicked","group":"navigation@2","when":"activeWebviewPanelId == roo-cline.TabPanelProvider"},{"command":"roo-cline.historyButtonClicked","group":"overflow@1","when":"activeWebviewPanelId == roo-cline.TabPanelProvider"},{"command":"roo-cline.popoutButtonClicked","group":"overflow@2","when":"activeWebviewPanelId == roo-cline.TabPanelProvider"}]},"keybindings":[{"command":"roo-cline.addToContext","key":"cmd+k cmd+a","mac":"cmd+k cmd+a","win":"ctrl+k ctrl+a","linux":"ctrl+k ctrl+a","when":"editorTextFocus && editorHasSelection"},{"command":"roo-cline.toggleAutoApprove","key":"cmd+alt+a","mac":"cmd+alt+a","win":"ctrl+alt+a","linux":"ctrl+alt+a"}],"submenus":[{"id":"roo-cline.contextMenu","label":"Roo Code"},{"id":"roo-cline.terminalMenu","label":"Roo Code"}],"configuration":{"title":"Roo Code","properties":{"roo-cline.allowedCommands":{"type":"array","items":{"type":"string"},"default":["git log","git diff","git show"],"description":"Commands that can be auto-executed when 'Always approve execute operations' is enabled"},"roo-cline.deniedCommands":{"type":"array","items":{"type":"string"},"default":[],"description":"Command prefixes that will be automatically denied without asking for approval. In case of conflicts with allowed commands, the longest prefix match takes precedence. Add * to deny all commands."},"roo-cline.commandExecutionTimeout":{"type":"number","default":0,"minimum":0,"maximum":600,"description":"Maximum time in seconds to wait for command execution to complete before timing out (0 = no timeout, 1-600s, default: 0s)"},"roo-cline.commandTimeoutAllowlist":{"type":"array","items":{"type":"string"},"default":[],"description":"Command prefixes that are excluded from the command execution timeout. Commands matching these prefixes will run without timeout restrictions."},"roo-cline.preventCompletionWithOpenTodos":{"type":"boolean","default":false,"description":"Prevent task completion when there are incomplete todos in the todo list"},"roo-cline.vsCodeLmModelSelector":{"type":"object","properties":{"vendor":{"type":"string","description":"The vendor of the language model (e.g. copilot)"},"family":{"type":"string","description":"The family of the language model (e.g. gpt-4)"}},"description":"Settings for VSCode Language Model API"},"roo-cline.customStoragePath":{"type":"string","default":"","description":"Custom storage path. Leave empty to use the default location. Supports absolute paths (e.g. 'D:\\RooCodeStorage')"},"roo-cline.enableCodeActions":{"type":"boolean","default":true,"description":"Enable Roo Code quick fixes"},"roo-cline.autoImportSettingsPath":{"type":"string","default":"","description":"Path to a RooCode configuration file to automatically import on extension startup. Supports absolute paths and paths relative to the home directory (e.g. '~/Documents/roo-code-settings.json'). Leave empty to disable auto-import."},"roo-cline.maximumIndexedFilesForFileSearch":{"type":"number","default":10000,"minimum":5000,"maximum":500000,"description":"Maximum number of files to index for the @ file search feature. Higher values provide better search results in large projects but may use more memory. Default: 10,000."},"roo-cline.useAgentRules":{"type":"boolean","default":true,"description":"Enable loading of AGENTS.md files for agent-specific rules (see https://agent-rules.org/)"},"roo-cline.apiRequestTimeout":{"type":"number","default":600,"minimum":0,"maximum":3600,"description":"Maximum time in seconds to wait for API responses (0 = no timeout, 1-3600s, default: 600s). Higher values are recommended for local providers like LM Studio and Ollama that may need more processing time."},"roo-cline.newTaskRequireTodos":{"type":"boolean","default":false,"description":"Require todos parameter when creating new tasks with the new_task tool"},"roo-cline.codeIndex.embeddingBatchSize":{"type":"number","default":60,"minimum":1,"maximum":200,"description":"The batch size for embedding operations during code indexing. Adjust this based on your API provider's limits. Default is 60."},"roo-cline.debug":{"type":"boolean","default":false,"description":"Enable debug mode to show additional buttons for viewing API conversation history and UI messages as prettified JSON in temporary files."},"roo-cline.debugProxy.enabled":{"type":"boolean","default":false,"description":"**Enable Debug Proxy** — Route all outbound network requests through a proxy for MITM debugging. Only active when running in debug mode (F5).","markdownDescription":"**Enable Debug Proxy** — Route all outbound network requests through a proxy for MITM debugging. Only active when running in debug mode (F5)."},"roo-cline.debugProxy.serverUrl":{"type":"string","default":"http://127.0.0.1:8888","description":"Proxy URL (e.g., `http://127.0.0.1:8888`). Only used when **Debug Proxy** is enabled.","markdownDescription":"Proxy URL (e.g., `http://127.0.0.1:8888`). Only used when **Debug Proxy** is enabled."},"roo-cline.debugProxy.tlsInsecure":{"type":"boolean","default":false,"description":"Accept self-signed certificates from the proxy. **Required for MITM inspection.** ⚠️ Insecure — only use for local debugging.","markdownDescription":"Accept self-signed certificates from the proxy. **Required for MITM inspection.** ⚠️ Insecure — only use for local debugging."}}}},"scripts":{"lint":"eslint . --ext=ts --max-warnings=0","check-types":"tsc --noEmit","pretest":"turbo run bundle --cwd .."
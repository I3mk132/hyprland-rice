@import "colors.rasi"

window {
    background-color: @surface-container;
    border:           2px;
    border-color:     @outline-variant;
    border-radius:    12px;
}

mainbox {
    background-color: transparent;
}

inputbar {
    background-color: @surface;
    text-color:       @on-surface;
    border-radius:    8px;
    padding:          8px 12px;
}

prompt {
    text-color: @primary;
}

entry {
    text-color: @on-surface;
}

listview {
    background-color: transparent;
}

element {
    background-color: transparent;
    text-color:       @on-surface;
    border-radius:    8px;
    padding:          6px 12px;
}

element selected {
    background-color: @primary-container;
    text-color:       @on-primary-container;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}
